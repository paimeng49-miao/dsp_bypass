name: Build dsp_bypass KPM

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout dsp_bypass repository
        uses: actions/checkout@v4

      - name: Install Dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y gcc-aarch64-linux-gnu make git

      - name: Clone KernelPatch
        run: |
          # 克隆 KernelPatch 到硬编码路径，因为 Makefile 里写死了 /home/runner/KernelPatch
          git clone --depth 1 https://github.com/bmax121/KernelPatch.git /home/runner/KernelPatch

      - name: Build KPM
        run: |
          # 强制覆盖 Makefile 里的 CC，使用标准 GCC
          make CC=aarch64-linux-gnu-gcc -j$(nproc)

      - name: Upload KPM artifact
        uses: actions/upload-artifact@v4
        with:
          name: dsp_bypass-kpm
          path: "*.kpm"
